// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}



model Project {
  id Int @id @default(autoincrement())
  title String
  image String
  description String
  liveUrl String
  githubUrl String
  tag String
  techs Skill[]
  categories Category[]
}

model Category {
  id Int @id @default(autoincrement())
  name String
  skills Skill[]
  projects Project[]
}

model Skill {
  id Int @id @default(autoincrement())
  name String @unique
  icon String
  description_en String
  description_fa String
  categoryId Int
  category Category @relation(fields: [categoryId], references: [id])
  level Int
  yearsOfExperience String
  status String
  projects Project[]
}

