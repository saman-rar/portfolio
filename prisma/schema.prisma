generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          Int        @id @default(autoincrement())
  title       String
  image       String
  description String
  liveUrl     String
  githubUrl   String
  tag         String
  categories  Category[] @relation("CategoryToProject")
  techs       Skill[]    @relation("ProjectToSkill")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  skills   Skill[]
  projects Project[] @relation("CategoryToProject")
}

model Skill {
  id                Int       @id @default(autoincrement())
  name              String    @unique
  icon              String
  description_en    String
  description_fa    String
  categoryId        Int
  level             Int
  yearsOfExperience String
  status            String
  category          Category  @relation(fields: [categoryId], references: [id])
  projects          Project[] @relation("ProjectToSkill")
}
